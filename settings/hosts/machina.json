{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "enabledModels": [
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-astra"
  ],
  "modelThinkingLevels": {
    "openai-codex/gpt-6-sol": "medium",
    "openai-codex/gpt-6-luna": "medium",
    "openai-codex/gpt-6-astra": "high"
  },
  "cacheWarming": "off",
  "defaultProjectTrust": "always",
  "skills": [
    ".agent/skills"
  ],
  "packages": [
    "git:github.com/nicobailon/pi-web-access@v0.30.0",
    "git:github.com/mjakl/pi-subagent@ce26a686f2571188d2e2b4d586e15a82606a7b72",
    "npm:pi-context-usage",
    "npm:pi-smart-router@0.8.0"
  ],
  "webAccess": {
    "workflow": "none",
    "tools": {
      "enabled": true
    },
    "image": {
      "enabled": false
    },
    "pdf": {
      "enabled": false
    }
  },
  "subagent": {
    "maxDepth": 2,
    "preventCycles": true
  },
  "audit": {
    "enabled": true,
    "approval": false,
    "logPath": "~/.pi/agent/audit.db",
    "logToolArguments": true
  },
  "memoryGate": {
    "enabled": true,
    "indexPath": ".agent/notes/INDEX.md",
    "notesDir": ".agent/notes",
    "explainDir": ".agent/explain",
    "injectIndexOnSessionStart": true,
    "blockRawNotesReads": true,
    "autoScaffold": true,
    "notesPerTask": 1
  },
  "readGuard": {
    "enabled": true,
    "dedupeWithinTurn": true,
    "diffOnRepeatAfterWrite": true,
    "allowRangeReads": true
  },
  "recap": {
    "enabled": true
  },
  "explain": {
    "enabled": true
  },
  "postEditTypecheck": {
    "enabled": true
  },
  "bounds": {
    "enabled": true,
    "maxTurnPromptTokens": 50000000,
    "maxTurnCostUsd": 30
  },
  "quotaGate": {
    "fiveHour": 95,
    "weekly": 95
  },
  "routing": {
    "enabled": false,
    "tiers": {
      "scout": "openai-codex/gpt-6-luna",
      "work": "openai-codex/gpt-6-sol",
      "escalate": "openai-codex/gpt-6-sol",
      "explain": "openai-codex/gpt-6-luna"
    }
  },
  "pipeline": {
    "plannerThinking": "high",
    "editorThinking": "medium"
  },
  "lastChangelogVersion": "0.87.1",
  "theme": "dark"
}
