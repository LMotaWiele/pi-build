{
  "defaultProvider": "provider",
  "defaultModel": "provider/model-id",
  "enabledModels": [
    "provider/model-id"
  ],
  "modelThinkingLevels": {
    "provider/model-id": "low"
  },
  "cacheWarming": "off",
  "defaultProjectTrust": "always",
  "skills": [
    ".agent/skills"
  ],
  "packages": [
    "git:github.com/nicobailon/pi-web-access@v0.30.0",
    "git:github.com/mjakl/pi-subagent@ce26a686f2571188d2e2b4d586e15a82606a7b72",
    "npm:pi-context-usage",
    "npm:pi-smart-router@0.8.0"
  ],
  "webAccess": {
    "workflow": "none",
    "tools": {
      "enabled": true
    },
    "image": {
      "enabled": false
    },
    "pdf": {
      "enabled": false
    }
  },
  "subagent": {
    "maxDepth": 2,
    "preventCycles": true
  },
  "audit": {
    "enabled": true,
    "approval": false,
    "logPath": "~/.pi/agent/audit.db",
    "logToolArguments": true
  },
  "memoryGate": {
    "enabled": true,
    "indexPath": ".agent/notes/INDEX.md",
    "notesDir": ".agent/notes",
    "explainDir": ".agent/explain",
    "injectIndexOnSessionStart": true,
    "blockRawNotesReads": true,
    "autoScaffold": true,
    "notesPerTask": 1
  },
  "readGuard": {
    "enabled": true,
    "dedupeWithinTurn": true,
    "diffOnRepeatAfterWrite": true,
    "allowRangeReads": true
  },
  "recap": {
    "enabled": true
  },
  "explain": {
    "enabled": true
  },
  "postEditTypecheck": {
    "enabled": true
  },
  "bounds": {
    "enabled": true,
    "maxLoopDepth": 60,
    "maxTurnWallClockMs": 600000,
    "maxConsecutiveToolFailures": 3,
    "noProgressReads": 6,
    "maxTurnPromptTokens": 20000000,
    "maxTurnCostUsd": 12
  },
  "map": {
    "enabled": true,
    "outDir": ".agent/map",
    "windowDays": 7,
    "uv": "uv"
  },
  "quotaGate": {
    "fiveHour": 95,
    "weekly": 95
  },
  "routing": {
    "enabled": false,
    "tiers": {
      "scout": "provider/model-id",
      "work": "provider/model-id",
      "escalate": "provider/model-id",
      "explain": "provider/model-id"
    }
  }
}
