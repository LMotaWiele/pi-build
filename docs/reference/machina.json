{
  "_comment": "pi-build v0.1 — symlink to ~/.pi/agent/settings.json. Keys marked VERIFY are not confirmed against the installed pi version; check `pi --help` and the settings docs before first run.",

  "defaultProvider": "openai",
  "defaultModel": "openai/gpt-5.6-terra",

  "enabledModels": [
    "openai/gpt-5.6-luna",
    "openai/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol"
  ],

  "modelThinkingLevels": {
    "openai/gpt-5.6-luna": "minimal",
    "openai/gpt-5.6-terra": "low",
    "openai-codex/gpt-5.6-sol": "high"
  },

  "cacheWarming": "off",

  "defaultProjectTrust": "trusted",

  "extensions": [
    "~/src/pi-build/extensions",
    "!**/wip-*"
  ],
  "skills": [
    "~/src/pi-build/skills",
    ".agent/skills"
  ],
  "prompts": ["~/src/pi-build/prompts"],
  "themes": ["~/src/pi-build/themes"],

  "packages": [],
  "_packages_note": "Do not hand-author. Run `pi install git:github.com/<owner>/<repo>@<tag>` for each of: nicobailon/pi-web-access, mjakl/pi-subagent, kcosr/pi-extensions, plus the status-bar and todos packages once verified. Pi writes the entries here; commit the diff.",

  "_copied_not_installed": [
    "plan mode — copy from pi's packages/coding-agent/examples/extensions/",
    "post-edit-typecheck.ts — copy from Rmnlly/pi-config"
  ],

  "webAccess": {
    "workflow": "none",
    "tools": { "enabled": true },
    "image": { "enabled": false },
    "pdf": { "enabled": false }
  },

  "subagent": {
    "maxDepth": 2,
    "preventCycles": true
  },

  "audit": {
    "enabled": true,
    "approval": false,
    "logPath": "~/.pi/agent/audit.db",
    "logToolArguments": true
  },

  "memoryGate": {
    "indexPath": ".agent/notes/INDEX.md",
    "notesDir": ".agent/notes",
    "explainDir": ".agent/explain",
    "injectIndexOnSessionStart": true,
    "blockRawNotesReads": true,
    "notesPerTask": 1
  },

  "readGuard": {
    "enabled": true,
    "dedupeWithinTurn": true,
    "diffOnRepeatAfterWrite": true,
    "allowRangeReads": true
  },

  "bounds": {
    "maxLoopDepth": 60,
    "maxTurnWallClockMs": 600000,
    "maxConsecutiveToolFailures": 3,
    "noProgressReads": 6
  },

  "routing": {
    "enabled": true,
    "decisionEndpoint": "https://openrouter.ai/api/alpha/decisions",
    "decisionModel": "typesafe/jev-1.13",
    "stateBudgetTokens": 4000,
    "defaultOnUncertain": "escalate",
    "tiers": {
      "scout": "openai/gpt-5.6-luna",
      "work": "openai/gpt-5.6-terra",
      "escalate": "openai-codex/gpt-5.6-sol",
      "explain": "openai/gpt-5.6-luna"
    }
  }
}
